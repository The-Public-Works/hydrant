# Copy to .env and fill in.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://ctx:ctx@localhost:5432/ctx

# GitHub personal access token (read-only public_repo is enough for public repos).
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_REPLACE_ME

# Voyage AI for embeddings — sign up at https://www.voyageai.com/, free tier
# is 200M tokens/month. The default rate limit is 3 RPM; adding a billing
# method (no charge) on the dashboard lifts it to 2000 RPM.
VOYAGE_API_KEY=pa-REPLACE_ME
VOYAGE_EMBED_MODEL=voyage-3-lite

# Optional: where the indexer keeps its working clones (default: ./.cache/repos)
# INDEXER_CACHE_DIR=./.cache/repos

# =============================================================
# Source tokens — each is optional. The matching `python -m indexer
# <source>` subcommand fails fast with a clear error if its token
# isn't set, so you only need the ones you actually plan to ingest.
# =============================================================

# --- Slack ---------------------------------------------------
# Required for `python -m indexer slack`.
# 1. Create an app at https://api.slack.com/apps -> "From scratch"
# 2. OAuth & Permissions -> add bot scopes:
#    channels:read, channels:history, users:read
#    (groups:read + groups:history if you want private channels too)
# 3. "Install to Workspace", copy the Bot User OAuth Token (starts xoxb-).
# 4. Invite the bot to each channel you want indexed: /invite @your-bot
SLACK_BOT_TOKEN=xoxb-REPLACE_ME

# Slack member IDs to auto-invite when `scripts/seed_slack_demo.py` creates
# channels. Comma-separated; each entry is either a member ID
# (U0B1ABC2DEF — find it under Profile -> ⋮ -> "Copy member ID") or an
# email (needs the `users:read.email` scope on the bot). Annotate each
# with the human name in a comment so we know who's who at a glance.
#   U0B1SMKB74N — Chetan Singh
#   U0B1VBP0B7U — Henning
DEMO_INVITE_USERS=U0B1SMKB74N,U0B1VBP0B7U

# --- Notion (NOT USED for the hackathon demo) --------------
# We decided to keep runbooks in GitHub instead, so this connector is
# unused. Code stays in the repo (indexer/notion_*.py + the matching
# `python -m indexer notion` subcommand) in case we want to flip it on
# later. Leave the placeholder; the indexer only fails if you actually
# run the notion subcommand without setting this.
# NOTION_API_KEY=ntn_REPLACE_ME

# --- Linear --------------------------------------------------
# Required for `python -m indexer linear`.
# 1. https://linear.app/settings/account/security -> "New API key"
#    (a personal API key is fine for the PoC; for production prefer OAuth.)
# 2. Copy the key (starts lin_api_).
# 3. Optional: scope ingestion with --teams to limit which Linear teams
#    are fetched, e.g. `python -m indexer linear --teams ENG OPS`.
LINEAR_API_KEY=lin_api_REPLACE_ME

# OpenRouter — used by the web demo (api/ + frontend/) for the chat agent.
# Sign up at https://openrouter.ai/, top up a few dollars (claude-sonnet-4.5
# is ~$3/MTok in, $15/MTok out — a demo session costs cents).
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional: where the frontend's chat panel sends its SSE request. The default
# (http://localhost:8765) bypasses Next dev's rewrite proxy, which buffers
# text/event-stream and breaks live streaming. Override only if the backend
# runs elsewhere.
# NEXT_PUBLIC_API_BASE=http://localhost:8765
